{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "*.env*": "ask",
      "git commit*": "ask",
      "git -C * commit*": "ask",
      "git push*": "ask",
      "git -C * push*": "ask",
      "git merge *": "ask",
      "git -C * merge *": "ask",
      "git rebase*": "ask",
      "git -C * rebase*": "ask",
      "git cherry-pick*": "ask",
      "git -C * cherry-pick*": "ask",
      "git reset*": "ask",
      "git -C * reset*": "ask",
      "git clean*": "ask",
      "git -C * clean*": "ask",
      "git checkout*": "ask",
      "git -C * checkout*": "ask",
      "git restore*": "ask",
      "git -C * restore*": "ask",
      "git stash*": "ask",
      "git -C * stash*": "ask",
      "git switch*": "ask",
      "git -C * switch*": "ask",
      "git branch -d*": "ask",
      "git -C * branch -d*": "ask",
      "git branch -D*": "ask",
      "git -C * branch -D*": "ask",
      "git tag*": "ask",
      "git -C * tag*": "ask",
      "git worktree add*": "ask",
      "git -C * worktree add*": "ask",
      "git worktree remove*": "ask",
      "git -C * worktree remove*": "ask",
      "git worktree prune*": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "ri *": "ask",
      "Remove-Item*": "ask",
      "npm publish*": "ask",
      "docker push*": "ask",
      "kubectl *": "ask",
      "terraform *": "ask",
      "helm *": "ask",
      "gh release*": "ask",
      "gh pr merge*": "ask",
      "gh repo delete*": "ask"
    },
    "webfetch": "ask"
  }
}
