{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tester output",
  "type": "object",
  "required": [
    "task_id",
    "role",
    "status",
    "commands_run",
    "results",
    "defects"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "tester",
        "queen"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "commands_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "exit_code"
        ],
        "properties": {
          "cmd": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "object",
      "required": [
        "passed",
        "failed"
      ],
      "properties": {
        "passed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "failed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "skipped": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "reproduction_steps",
          "expected",
          "actual"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reproduction_steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "suspected_location": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
