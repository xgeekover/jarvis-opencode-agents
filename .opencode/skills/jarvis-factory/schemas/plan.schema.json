{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan artifact",
  "type": "object",
  "required": ["architecture", "tasks", "recommended_track"],
  "properties": {
    "architecture": {
      "type": "object",
      "required": ["proposal"],
      "properties": {
        "proposal": {"type": "string"},
        "alternatives_considered": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "depends_on", "parallelizable"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "files_expected": {"type": "array", "items": {"type": "string"}},
          "parallelizable": {"type": "boolean"},
          "size": {"type": "string", "enum": ["S", "M", "L"]}
        }
      }
    },
    "recommended_track": {"type": "string", "enum": ["simple", "standard", "parallel"]},
    "track_rationale": {"type": "string"}
  }
}
