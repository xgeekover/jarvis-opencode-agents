{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task envelope (Queen -> agent input)",
  "type": "object",
  "required": ["task_id", "project_id", "role", "stage", "objective", "attempt"],
  "properties": {
    "task_id": {"type": "string"},
    "project_id": {"type": "string"},
    "role": {"type": "string", "enum": ["planner", "developer", "tester", "reviewer", "integrator"]},
    "stage": {"type": "string"},
    "objective": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 0},
    "workdir": {"type": ["string", "null"]},
    "base_ref": {"type": ["string", "null"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"},
    "previous_failures": {"type": "array", "items": {"type": "object"}},
    "commands": {"type": "object"}
  }
}
